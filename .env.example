# GEMINI_API_KEY: Required for Gemini AI API calls (Ask Sophie assistant).
# Set this in your environment or in Vercel (Project Settings > Environment Variables).
GEMINI_API_KEY=your_key_here

# GEMINI_MODEL: Optional model override (defaults to gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
